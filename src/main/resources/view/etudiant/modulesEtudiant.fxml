<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import java.lang.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.etudiant.ModulesEtudiantController"
            prefHeight="700.0" prefWidth="1200.0">

    <!-- SIDEBAR -->
    <VBox style="-fx-background-color: #142b77; -fx-background-radius: 0 40 40 0;"
          prefWidth="250"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">

        <VBox spacing="2" style="-fx-padding: 100 0 0 20;">

            <!-- ACCUEIL -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-padding: 12 0 12 30;"
                  onMouseClicked="#handleHome">
                <ImageView fitWidth="27" fitHeight="27">
                    <image><Image url="/images/Bhome.png"/></image>
                </ImageView>
                <Label text="Accueil"
                       style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <!-- PROFIL -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 0 12 30;" onMouseClicked="#handleProfil">
                <ImageView fitWidth="30" fitHeight="30">
                    <image><Image url="@../../images/stagiaire.png"/></image>
                </ImageView>
                <Label text="Profil" style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <!-- NOTES -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 0 12 30;" onMouseClicked="#handleNotes">
                <ImageView fitWidth="35" fitHeight="35">
                    <image><Image url="@../../images/note.png"/></image>
                </ImageView>
                <Label text="Notes" style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 6;"/>
            </HBox>

            <!-- PLANNING (ACTIF) -->
            <HBox alignment="CENTER_LEFT"
                  style=" -fx-padding: 12 0 12 30;"
                  onMouseClicked="#handleEmploiDuTemps">
                <ImageView fitWidth="30" fitHeight="30">
                    <image><Image url="/images/calendrier.png"/></image>
                </ImageView>
                <Label text="Planning"
                       style=" -fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 7;"/>
            </HBox>

            <!-- Module -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f4; -fx-background-radius: 30 0 0 30; -fx-padding: 12 0 12 30;" onMouseClicked="#handleModules">
                <ImageView fitWidth="30" fitHeight="30">
                    <image><Image url="@../../images/module-hover.png"/></image>
                </ImageView>
                <Label text="Modules" style="-fx-text-fill: #43639a; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- DÉCONNEXION -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-padding: 400 0 12 30;"
                  onMouseClicked="#handleLogout">
                <ImageView fitWidth="30" fitHeight="30">
                    <image><Image url="/images/logout.png"/></image>
                </ImageView>
                <Label text="Déconnexion"
                       style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <Region prefHeight="20"/>
        </VBox>
    </VBox>

    <!-- CONTENU PRINCIPAL -->
    <VBox AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="250"
          AnchorPane.rightAnchor="0">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 40 40 0 40;">
            <HBox alignment="CENTER_LEFT" spacing="5">
                <ImageView fitWidth="130" fitHeight="137" preserveRatio="true" style="-fx-padding: 0 27 0 0;">
                    <image><Image url="/images/notes 2.png"/></image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding: 2 0 0 0;">
                    <Label fx:id="versionLabel" text="V 0.1.0"
                           style="-fx-font-size: 10; -fx-background-color: #ef4444; -fx-padding: 2 8; -fx-background-radius: 10; -fx-text-fill: white;"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- École -->
            <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 0 30 0 0">
                <ImageView fitWidth="48" fitHeight="40">
                    <image>
                        <Image url="/images/ecole(1).png"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="École" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="nomEcoleLabel" style="-fx-font-size: 18; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>

            <!-- Étudiant -->
            <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 0 30 0 0">
                <ImageView fitWidth="48" fitHeight="40">
                    <image>
                        <Image url="/images/profil.png"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Étudiant" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="nomEtudiantLabel" style="-fx-font-size: 18; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- CONTENU -->
        <VBox style="-fx-padding: 40 40;" spacing="20">
            <!-- Titre -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Mes Modules"
                               style="-fx-font-size: 46px; -fx-font-weight: bold; -fx-font-family: 'Apple Chancery';"/>
                    </HBox>
                    <Label text="Liste des modules de mon groupe - Utilisez le filtre pour effectuer une recherche rapide."
                           style="-fx-text-fill: #666; -fx-padding: 0 0 0 30"/>
                </VBox>
            </HBox>

            <!-- Formulaire de Filtrage -->
            <VBox spacing="15" alignment="CENTER">
                <!-- Première ligne du filtre -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox styleClass="float-input-container" prefWidth="300">
                        <Label text="Nom du module" styleClass="float-label"/>
                        <TextField fx:id="nomModuleField"
                                   styleClass="float-text-field"
                                   prefHeight="35"/>
                    </VBox>

                    <VBox styleClass="float-input-container" prefWidth="300">
                        <Label text="Matricule module" styleClass="float-label"/>
                        <TextField fx:id="matriculeModuleField"
                                   styleClass="float-text-field"
                                   prefHeight="35"/>
                    </VBox>

                    <VBox styleClass="float-input-container" prefWidth="300">
                        <Label text="Formateur" styleClass="float-label"/>
                        <ComboBox fx:id="formateurComboBox"
                                  prefWidth="300" prefHeight="35"
                                  styleClass="float-text-field"/>
                    </VBox>
                </HBox>

                <!-- Boutons du filtre -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Réinitialiser"
                            style="-fx-text-fill: #666; -fx-background-color: transparent;"
                            onAction="#reinitialiserFiltres"/>
                    <Button text="Filtrer"
                            style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-padding: 10 20; -fx-background-radius: 5;"
                            onAction="#filtrerModules"/>
                </HBox>
            </VBox>

            <!-- Tableau des Modules -->
            <TableView fx:id="modulesTable" styleClass="custom-table" stylesheets="@/styles/gestionFormateurs.css">
                <columns>
                    <TableColumn text="Nom" fx:id="nomColumn" prefWidth="250"/>
                    <TableColumn text="Matricule" fx:id="matriculeColumn" prefWidth="100"/>
                    <TableColumn text="Date début" fx:id="dateDebutColumn" prefWidth="125"/>
                    <TableColumn text="Date fin" fx:id="dateFinColumn" prefWidth="125"/>
                    <TableColumn text="Heures présentiel" fx:id="heuresPresentielColumn" prefWidth="120"/>
                    <TableColumn text="Formateur" fx:id="formateurColumn" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>