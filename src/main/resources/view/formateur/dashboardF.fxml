<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<?import javafx.collections.FXCollections?>
<AnchorPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.FormateurDashboardController"
            style="-fx-background-color: #f5f5f4;">

    <!-- SIDEBAR -->
    <VBox style="-fx-background-color: #142b77; -fx-background-radius: 0 40 40 0;"
          prefWidth="250"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">

        <!-- Profile Image -->
        <StackPane alignment="CENTER" style="-fx-padding: 40 0 20 0;">
            <Circle radius="60" fill="white"/>
            <ImageView fx:id="profileImageView" fitWidth="110" fitHeight="110" preserveRatio="true">
                <image>
                    <Image url="@../../images/profil.png"/>
                </image>
            </ImageView>
        </StackPane>

        <VBox spacing="2" style="-fx-padding: 100 0 0 20;">

            <!-- HOME -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #f5f5f4; -fx-background-radius: 30 0 0 30; -fx-padding: 12 0 12 30;"
                  onMouseClicked="#handleHome">
                <ImageView fitWidth="27" fitHeight="27">
                    <image><Image url="@../../images/Bhome-hover.png"/></image>
                </ImageView>
                <Label text="Home" style="-fx-text-fill: #43639a; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <!-- PROFILE -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 0 12 30;" onMouseClicked="#handleProfile">
                <ImageView fitWidth="30" fitHeight="30">
                    <image><Image url="@../../images/prof.png"/></image>
                </ImageView>
                <Label text="Profile" style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <!-- GROUPES -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 0 12 30;" onMouseClicked="#handleGroupes">
                <ImageView fitWidth="30" fitHeight="30">
                    <image><Image url="@../../images/groupe.png"/></image>
                </ImageView>
                <Label text="Groupes" style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <!-- MODULES -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 0 12 30;" onMouseClicked="#handleModules">
                <ImageView fitWidth="27" fitHeight="27">
                    <image><Image url="@../../images/module.png"/></image>
                </ImageView>
                <Label text="Modules" style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <!-- NOTES -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 0 12 30;" onMouseClicked="#handleNotes">
                <ImageView fitWidth="35" fitHeight="35">
                    <image><Image url="@../../images/note.png"/></image>
                </ImageView>
                <Label text="Notes" style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 7;"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- LOGOUT -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 350 0 12 30;" onMouseClicked="#handleLogout">
                <ImageView fitWidth="30" fitHeight="30">
                    <image><Image url="@../../images/logout.png"/></image>
                </ImageView>
                <Label text="Log out" style="-fx-text-fill: white; -fx-font-size: 17;-fx-padding: 0 0 0 10;"/>
            </HBox>

            <Region prefHeight="20"/>
        </VBox>
    </VBox>

    <!-- MAIN CONTENT -->
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="250" AnchorPane.rightAnchor="0">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 40 0 40;">

            <!-- LOGO -->
            <HBox alignment="CENTER_LEFT" spacing="5">
                <ImageView fitWidth="130" fitHeight="137" preserveRatio="true" style="-fx-padding: 0 27 0 0;">
                    <image><Image url="/images/notes 2.png"/></image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding: 2 0 0 0;">
                    <Label fx:id="versionLabel" text="V 0.1.0"
                           style="-fx-font-size: 10; -fx-background-color: #ef4444; -fx-padding: 2 8; -fx-background-radius: 10; -fx-text-fill: white;"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- ECOLE -->
            <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 0 30 0 0">
                <ImageView fitWidth="48" fitHeight="40">
                    <image>
                        <Image url="/images/ecole(1).png"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="École" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="nomEcoleLabel" style="-fx-font-size: 18; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>


            <!-- NOM FORMATEUR -->
            <HBox alignment="CENTER_LEFT" spacing="5">
                <ImageView fitWidth="48" fitHeight="40">
                    <image>
                        <Image url="/images/profil.png"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Professeur" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="nomFormateurLabel" style="-fx-font-size: 18; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- WELCOME SECTION -->
        <HBox style="-fx-padding: 0 0 0 44;">

            <!-- WELCOME TEXT -->
            <VBox style="-fx-padding: 112 0 0 44;" prefWidth="500">
                <Label text="Bonjour" style="-fx-font-size: 30; -fx-font-weight: 600;"/>
                <Label fx:id="welcomeNameLabel" style="-fx-font-size: 48; -fx-font-weight: bold;"/>
                <Label text="Un système d'information intégré qui permet la
mise en place de nouvelles méthodes de gestion scolaire."
                       wrapText="true" style="-fx-font-size: 20; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- TODAY LABEL -->
            <VBox alignment="CENTER" prefWidth="40" prefHeight="200" style="-fx-padding: 85 30 0 150;">
                <ImageView fitWidth="32" fitHeight="160">
                    <image>
                        <Image url="/images/today.png"/>
                    </image>
                </ImageView>
            </VBox>

            <!-- STATS CARDS -->
            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 100 40 0 0;">

                <!-- MODULES CARD -->
                <VBox fx:id="cardModules" prefWidth="224" prefHeight="256"
                      style="-fx-background-color: #059669; -fx-background-radius: 30; -fx-padding: 12;">
                    <Label text="01" style="-fx-text-fill: white; -fx-font-size: 18;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <StackPane alignment="CENTER">
                        <ImageView fitWidth="80" fitHeight="80">
                            <image><Image url="@../../images/module.png"/></image>
                        </ImageView>
                    </StackPane>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Modules" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>
                    <Label fx:id="modulesCountLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 18;"/>
                </VBox>

                <!-- STAGIAIRES CARD -->
                <VBox fx:id="cardEtudiants" prefWidth="224" prefHeight="256"
                      style="-fx-background-color: #3730a3; -fx-background-radius: 30; -fx-padding: 12;">
                    <Label text="02" style="-fx-text-fill: white; -fx-font-size: 18;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <StackPane alignment="CENTER">
                        <ImageView fitWidth="80" fitHeight="80">
                            <image><Image url="@../../images/stagiaire.png"/></image>
                        </ImageView>
                    </StackPane>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Stagiaires" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>
                    <Label fx:id="stagiairesCountLabel" text="0/0" style="-fx-text-fill: white; -fx-font-size: 18;"/>
                </VBox>

                <!-- GROUPES CARD -->
                <VBox fx:id="cardGroupes" prefWidth="224" prefHeight="256"
                      style="-fx-background-color: #ef4444; -fx-background-radius: 30; -fx-padding: 12;">
                    <Label text="03" style="-fx-text-fill: white; -fx-font-size: 18;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <StackPane alignment="CENTER">
                        <ImageView fitWidth="80" fitHeight="80">
                            <image><Image url="@../../images/groupe.png"/></image>
                        </ImageView>
                    </StackPane>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Groupes" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>
                    <Label fx:id="groupesCountLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 18;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- EXAMENS SECTION + CALENDAR -->
        <HBox style="-fx-padding: 40 40 40 165;" spacing="40">

            <!-- EXAMENS TABLE -->

            <Region HBox.hgrow="ALWAYS"/>
            <!-- CALENDAR -->
            <VBox prefWidth="490" style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 20;">

                <HBox alignment="CENTER">
                    <Button text="&lt;" onAction="#previousMonth" style="-fx-background-color: transparent; -fx-font-size: 20;"/>
                    <Label fx:id="monthYearLabel" text="Février 2024" style="-fx-font-size: 25; -fx-font-weight: 600;">
                        <HBox.hgrow>ALWAYS</HBox.hgrow>
                    </Label>
                    <Button text="&gt;" onAction="#nextMonth" style="-fx-background-color: transparent; -fx-font-size: 20;"/>
                </HBox>

                <GridPane fx:id="calendarGrid" hgap="2" vgap="2" style="-fx-padding: 10;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="14.28"/>
                        <ColumnConstraints percentWidth="14.28"/>
                        <ColumnConstraints percentWidth="14.28"/>
                        <ColumnConstraints percentWidth="14.28"/>
                        <ColumnConstraints percentWidth="14.28"/>
                        <ColumnConstraints percentWidth="14.28"/>
                        <ColumnConstraints percentWidth="14.28"/>
                    </columnConstraints>
                </GridPane>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>